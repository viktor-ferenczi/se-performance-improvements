<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Unit-test project, not a plugin: it is not listed in the plugin XML
         descriptors and is never deployed by Pulsar/Magnetar. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test the self-contained RateLimiter utility in isolation, without pulling
         in the game-dependent Shared patches and their assembly references. -->
    <Compile Include="..\Shared\Tools\RateLimiter.cs" Link="Shared\Tools\RateLimiter.cs" />
    <Compile Include="..\Shared\Config\IPluginConfig.cs" Link="Shared\Config\IPluginConfig.cs" />
    <!-- Its only game-dependent reference, Common.Logger, is stubbed in the test -->
    <Compile Include="..\Shared\Patches\OptionalPatch.cs" Link="Shared\Patches\OptionalPatch.cs" />
    <Compile Include="..\Shared\Tools\ScriptCacheKey.cs" Link="Shared\Tools\ScriptCacheKey.cs" />
    <Compile Include="..\Shared\Tools\RunQueue.cs" Link="Shared\Tools\RunQueue.cs" />
    <!-- The prepatch needs only Mono.Cecil; the test loads the game's VRage.Library.dll itself -->
    <Compile Include="..\Shared\Patches\ScriptRunner\IlInjectorPrepatch.cs" Link="Shared\Patches\IlInjectorPrepatch.cs" />
  </ItemGroup>

</Project>
